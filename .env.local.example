# Copy this file to .env.local and fill in your values.
# Find these under Supabase → Project Settings → API Keys.

# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) — safe to expose to the browser,
# used for customer/staff login sessions (Supabase Auth).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or legacy service_role key — SECRET,
# server-only. Never expose this in client-side code or commit it.
# Bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Which tenant this deployment serves. Matches the id from
# supabase/seed.sql (Globowax Malta) until multi-tenant routing is added.
TENANT_ID=11111111-1111-1111-1111-111111111111
